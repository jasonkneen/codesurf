{
  "name": "codesurf",
  "version": "1.1.5",
  "description": "CodeSurf CLI — an open-source AI coding agent powered by Grok, built with Bun and OpenTUI.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "codesurf": "dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsc -b ../../packages/plugin-api ../../packages/runtime && tsc",
    "build:binary": "bun build --compile --outfile dist/codesurf-standalone ./src/index.ts",
    "start": "bun run dist/index.js",
    "typecheck": "tsc -b ../../packages/plugin-api ../../packages/runtime && tsc --noEmit",
    "test": "bunx vitest run",
    "test:bun": "bun test src/core/plugins/sinks.bun.test.ts src/agent/trace-collection.test.ts src/agent/adaptive-routing.test.ts src/agent/learning/skill-optimizer.test.ts src/ui/components/prompt-bar.test.ts src/ui/components/claude-code-title-bar.test.ts src/ui/components/claude-code-pending-messages.test.ts",
    "test:all": "bun run test && bun run test:bun",
    "test:watch": "bunx vitest",
    "lint": "biome check src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "lint:fix": "biome check --fix src/",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "bench:startup": "bun scripts/bench/startup.mjs",
    "bench:replay": "bun scripts/bench/replay.mjs",
    "web:dev": "bunx vite --config vite.web.config.mjs",
    "web:build": "bunx vite build --config vite.web.config.mjs",
    "web:live-smoke": "bun run web:build && bun scripts/web/smoke-live.mjs",
    "parity:terminal": "bun scripts/parity/capture-terminal.tsx",
    "parity:browser": "bun scripts/parity/capture-browser.mjs",
    "parity": "bun run web:build && bun run parity:terminal && bun run parity:browser && bun scripts/parity/compare.mjs",
    "bench:ptc-vs-native": "bun scripts/bench/ptc-vs-native.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json}": "biome check --write --no-errors-on-unmatched"
  },
  "keywords": [
    "cli",
    "agent",
    "ai",
    "coding",
    "terminal",
    "opentui"
  ],
  "author": "Vibe Kit",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/mcp": "^1.0.25",
    "@ai-sdk/provider": "^3.0.10",
    "@ai-sdk/provider-utils": "^4.0.21",
    "@ai-sdk/xai": "^3.0.67",
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@codesurf/daemon": "workspace:*",
    "@codesurf/plugin-api": "workspace:*",
    "@codesurf/runtime": "workspace:*",
    "@coinbase/agentkit": "^0.10.4",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.1-rc.2",
    "@lancedb/lancedb": "^0.22.3",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@npmcli/arborist": "^9.4.2",
    "@opencode-ai/sdk": "^1.16.2",
    "@opentui/core": "^0.1.88",
    "@opentui/react": "^0.1.88",
    "@x402/evm": "^2.16.0",
    "@x402/fetch": "^2.16.0",
    "@xenova/transformers": "^2.17.0",
    "@xterm/headless": "^6.0.0",
    "agent-desktop": "^0.1.11",
    "ai": "^6.0.116",
    "commander": "^12.1.0",
    "diff": "^8.0.3",
    "dotenv": "^16.6.1",
    "grammy": "^1.41.1",
    "react": "19.2.5",
    "semver": "^7.7.4",
    "sharp": "^0.34.5",
    "viem": "^2.53.1",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-types": "^3.17.5",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "overrides": {
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@deepseek-ai/dsh-agent-tool-presentation": "0.1.0-rc.6",
    "@deepseek-ai/dsh-persona": "0.0.1-rc.1",
    "@deepseek-ai/dsh-shell-env": "0.0.1-rc.3",
    "@deepseek-ai/dsh-skill-badge": "0.0.1-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.0.1-rc.3",
    "@deepseek-ai/dsh-tool-web": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-web-fetch-http": "0.0.1-rc.5",
    "@types/bun": "^1.3.12",
    "@types/diff": "^8.0.0",
    "@types/node": "^22.19.15",
    "@types/npmcli__arborist": "^6.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.7",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.4.0",
    "react-dom": "19.2.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "preferGlobal": true
}
