# Codesurf Configuration (uses xAI Grok API)
# Legacy GROK_* env vars are still honored as a fallback for each variable.
CODESURF_API_KEY=your_grok_api_key_here

# Optional: Custom API base URL (default: https://api.x.ai/v1)
# CODESURF_BASE_URL=https://api.x.ai/v1

# Optional: Default model (default: grok-4-1-fast-reasoning)
# CODESURF_MODEL=grok-4-1-fast-reasoning
# Optional: Default model (default: grok-4.3)
# GROK_MODEL=grok-4.3

# Optional: Max tokens per response (default: 16384)
# CODESURF_MAX_TOKENS=16384

# Optional: Telegram bot token for /connect → Telegram (see README)
# TELEGRAM_BOT_TOKEN=123456:ABC...
