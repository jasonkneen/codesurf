{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noEmit": true,
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/renderer/src/*"],
      "@codesurf/chat-bridge": ["./packages/codesurf-chat-bridge/src/index.ts"],
      "@codesurf/chat-bridge/*": ["./packages/codesurf-chat-bridge/src/*"],
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "packages/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "packages/codesurf-relay/src/**/*.test.ts",
    "packages/codesurf-relay/vitest.config.ts"
  ]
}
