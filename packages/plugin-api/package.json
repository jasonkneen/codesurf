{
  "name": "@codesurf/plugin-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Structural contracts, DTOs and Cordis Context augmentation for native CodeSurf plugins.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./ui": {
      "bun": "./src/ui.ts",
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  }
}
