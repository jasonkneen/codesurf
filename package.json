{
  "name": "codesurf",
  "version": "0.1.0",
  "productName": "CodeSurf",
  "description": "Infinite canvas workspace for AI agents",
  "main": "dist-electron/main/index.js",
  "bin": {
    "codesurf": "bin/codesurf.cjs",
    "codesurfd": "bin/codesurfd.mjs"
  },
  "files": [
    "bin/",
    "dist-electron/",
    "packages/codesurf-relay/dist/",
    "resources/",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "prepack": "npm run verify:daemon-dist",
    "test": "npm run test:unit && npm run test:packages",
    "pretest:unit": "npm run build:main",
    "test:unit": "npm run test:unit:core && npm run test:unit:electron-hosts",
    "test:unit:core": "node --experimental-strip-types --experimental-test-module-mocks --test test/*.test.ts test/*.test.mjs test/main/*.test.mjs test/sidebar/*.test.mjs test/daemon/*.test.mjs test/platform/*.test.mjs",
    "test:unit:coverage": "npm run build:main && node --experimental-strip-types --experimental-test-module-mocks --experimental-test-coverage --test test/*.test.ts test/*.test.mjs test/main/*.test.mjs test/sidebar/*.test.mjs test/daemon/*.test.mjs test/platform/*.test.mjs",
    "test:unit:electron-hosts": "node --test --test-concurrency=1 test/hosts/*.test.mjs",
    "test:relay": "npm --prefix packages/codesurf-relay test",
    "test:terminal-gateway": "npm --prefix packages/codesurf-terminal-gateway test",
    "test:npm-package": "npm run build:npm && node scripts/smoke-npm-package.mjs",
    "test:packages": "npm run check-daemon-canonical && npm run test:relay && npm run test:terminal-gateway",
    "test:all": "npm test",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:build": "npm run build && npm run build:web && npm run test:e2e && npm run test:web-smoke",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:web-smoke": "playwright test --config e2e/web.playwright.config.ts",
    "check:change-size": "node scripts/check-change-size.mjs",
    "check:daemon-boundaries": "node scripts/check-daemon-boundaries.mjs",
    "check:daemon-interface": "node scripts/daemon-interface.mjs",
    "update:daemon-interface": "node scripts/daemon-interface.mjs --update",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check package.json .prettierrc.json eslint.config.mjs \".github/workflows/*.{yml,yaml}\"",
    "check": "npm run lint && npm run format:check && npm run check:daemon-boundaries && npm run typecheck",
    "typecheck": "npm run typecheck:go",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit",
    "typecheck:go": "tsgo -p tsconfig.tsgo.json --noEmit",
    "typecheck:go:watch": "tsgo -p tsconfig.tsgo.json --noEmit --watch --pretty false",
    "dev": "node scripts/dev.js",
    "dev:go": "node scripts/dev-go.js",
    "web:dev": "node scripts/web-dev.mjs",
    "web:vite": "vite --config vite.web.config.ts",
    "web:host": "node scripts/web-host.mjs",
    "web:preview": "node scripts/web-preview.mjs",
    "web:preview:vite": "vite preview --config vite.web.config.ts",
    "web:pwa": "cross-env CODESURF_PWA_DEV=1 node scripts/web-dev.mjs",
    "build:daemon": "node scripts/check-daemon-canonical.mjs",
    "build:web": "vite build --config vite.web.config.ts",
    "verify:web-build": "node scripts/verify-web-build.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:dist": "node scripts/desktop-build.mjs",
    "perf:render": "node scripts/measure-render.js",
    "build:main": "cross-env EV_BUILD_TARGET=main electron-vite build",
    "build:preload": "cross-env EV_BUILD_TARGET=preload electron-vite build",
    "build:renderer": "cross-env EV_BUILD_TARGET=renderer electron-vite build",
    "build": "cross-env EV_BUILD_TARGET=main electron-vite build && cross-env EV_BUILD_TARGET=preload electron-vite build && cross-env EV_BUILD_TARGET=renderer electron-vite build",
    "build:npm": "node scripts/build-npm-package.mjs",
    "dist:npm": "npm run build:npm --",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "release:mac": "node scripts/verify-mac-release-env.mjs && npm run build && electron-builder --mac dmg zip",
    "dist:windows": "npm run build && electron-builder --win nsis portable",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "build:icon": "node scripts/create-ico.js",
    "release:github": "node scripts/verify-mac-release-env.mjs && npm run build && electron-builder --mac dmg zip --publish always",
    "dogfood": "npm run build && electron-vite preview",
    "preview": "npm run verify:daemon-dist && electron-vite preview",
    "dev:electrobun": "npm run build:renderer && electrobun dev",
    "build:electrobun": "npm run build:renderer && electrobun build --targets=current",
    "run:electrobun": "electrobun run",
    "smoke:electrobun": "npm run build:electrobun && node scripts/smoke-electrobun.mjs",
    "acceptance:electrobun": "npm run build:electrobun && node scripts/accept-electrobun.mjs",
    "verify:electrobun-runtime": "npm run build:electrobun && node scripts/smoke-electrobun.mjs && node scripts/accept-electrobun.mjs",
    "validate-extension": "node scripts/validate-extension.mjs",
    "ensure-electron": "node scripts/ensure-electron.js",
    "rebuild": "node scripts/rebuild-natives.mjs",
    "postinstall": "node scripts/ensure-electron.js && node scripts/rebuild-natives.mjs",
    "check-daemon-canonical": "node scripts/check-daemon-canonical.mjs",
    "verify:daemon-dist": "node scripts/check-daemon-canonical.mjs"
  },
  "keywords": [],
  "author": "Jason",
  "license": "AGPL-3.0-only",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.8",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript/native-preview": "^7.0.0-dev.20260504.1",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.27",
    "brace-expansion": "5.0.9",
    "cross-env": "^10.1.0",
    "ejs": "5.0.2",
    "electron": "41.10.5",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "extract-zip": "2.0.1",
    "globals": "17.8.0",
    "node-gyp": "12.4.0",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-test-renderer": "^19.2.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.2.0"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.60",
    "@anthropic-ai/claude-agent-sdk": "0.2.141",
    "@codesurf/daemon": "file:../../Documents/GitHub/grok-cli/packages/codesurf-daemon",
    "@mcp-ui/client": "^7.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@openai/codex-sdk": "^0.139.0",
    "@opencode-ai/sdk": "^1.2.27",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@ricky0123/vad-web": "^0.0.30",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.74",
    "better-sqlite3": "^12.8.0",
    "blobatar": "^2.3.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electrobun": "^1.16.0",
    "electron-updater": "6.8.9",
    "elkjs": "^0.11.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "0.56.0",
    "morphcloud": "^0.0.20",
    "motion": "^12.38.0",
    "nanoid": "^5.1.11",
    "node-pty": "1.1.0",
    "onnxruntime-web": "^1.24.3",
    "radix-ui": "^1.4.3",
    "sharp": "^0.35.3",
    "shiki": "^4.0.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "use-stick-to-bottom": "^1.1.4"
  },
  "optionalDependencies": {
    "@emnapi/runtime": "1.11.1",
    "@img/sharp-wasm32": "0.35.3"
  },
  "overrides": {
    "@babel/core": "$@babel/core",
    "brace-expansion": "$brace-expansion",
    "ejs": "$ejs",
    "esbuild": "$esbuild",
    "fast-uri": "3.1.5",
    "monaco-editor": {
      "dompurify": "3.4.13"
    },
    "vite-plugin-pwa": {
      "workbox-build": {
        ".": "7.4.0",
        "@rollup/plugin-terser": "1.0.0"
      },
      "workbox-window": "7.4.0"
    }
  },
  "build": {
    "appId": "com.huggiapps.codesurf",
    "productName": "CodeSurf",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "bin/**/*",
      "package.json",
      "resources/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/node-pty/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "examples/extensions/agent-kanban",
        "to": "bundled-extensions/agent-kanban"
      },
      {
        "from": "bundled-extensions",
        "to": "bundled-extensions",
        "filter": [
          "**/*",
          "!agent-kanban",
          "!agent-kanban/**"
        ]
      }
    ],
    "beforeBuild": "scripts/before-build.js",
    "icon": "resources/icon.png",
    "fileAssociations": [
      {
        "ext": "skill",
        "name": "Claude Skill",
        "description": "Claude agent skill bundle",
        "role": "Viewer",
        "icon": "resources/icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "gatekeeperAssess": false,
      "notarize": true,
      "forceCodeSigning": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "CodeSurf uses the microphone for voice dictation and agent voice features.",
        "NSCameraUsageDescription": "CodeSurf uses the camera for workspace browser and extension surfaces that request camera access."
      }
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "linux": {
      "category": "Development",
      "icon": "resources/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jkneen",
        "repo": "collaborator-clone"
      }
    ]
  }
}
